// Core schema. Table and column names are snake_case via @map/@@map; ids are uuid v7 generated by Prisma.
//
// Objects Prisma cannot express are added by hand in the migration SQL (each with a comment there):
//  - documents.position is COLLATE "C" (fractional keys compare bytewise)
//  - partial indexes (WHERE deleted_at IS NULL) keep the names declared below, so `migrate diff` sees no drift
//  - pg_trgm / unaccent extensions
//  - document_search.tsv is a GENERATED column (and cd_unaccent() its IMMUTABLE wrapper); the GIN indexes on it
//    and on the title use the operator classes declared below
//
// onDelete policy: Cascade for rows that are meaningless without their parent (memberships, tokens, shares,
// links, subscription); Restrict where deleting would silently destroy shared user content
// (a workspace owner, a document's workspace/author) - deletion is always soft or an explicit workflow.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER

  @@map("workspace_role")
}

enum ShareRole {
  VIEWER
  EDITOR

  @@map("share_role")
}

enum DocumentVisibility {
  WORKSPACE
  RESTRICTED

  @@map("document_visibility")
}

enum PlanTier {
  FREE
  PRO
  TEAM

  @@map("plan_tier")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED

  @@map("subscription_status")
}

enum DocumentVersionKind {
  AUTO
  MANUAL
  PRE_RESTORE

  @@map("document_version_kind")
}

enum NotificationType {
  MENTION

  @@map("notification_type")
}

enum PublicLinkMode {
  VIEW
  EDIT

  @@map("public_link_mode")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique // stored lower-case; normalised by the application
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens      RefreshToken[]
  ownedWorkspaces    Workspace[]
  memberships        WorkspaceMember[]
  invitesSent        WorkspaceInvite[]
  documentsCreated   Document[]
  documentShares     DocumentShare[]
  publicLinksCreated PublicLink[]
  versionsCreated    DocumentVersion[]
  attachments        Attachment[]
  commentThreads     CommentThread[]
  comments           Comment[]
  commentMentions    CommentMention[]
  notifications      Notification[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt  DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner        User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  subscription Subscription?
  documents    Document[]
  attachments  Attachment[]
  searchRows   DocumentSearch[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique @map("token_hash")
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime?     @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  invitedBy   String        @map("invited_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation(fields: [invitedBy], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@map("workspace_invites")
}

model Subscription {
  id               String             @id @default(uuid(7)) @db.Uuid
  workspaceId      String             @unique @map("workspace_id") @db.Uuid
  plan             PlanTier           @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?          @map("current_period_end") @db.Timestamptz(6)
  lastEventAt      DateTime?          @map("last_event_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Document {
  id               String             @id @default(uuid(7)) @db.Uuid
  workspaceId      String             @map("workspace_id") @db.Uuid
  parentId         String?            @map("parent_id") @db.Uuid
  title            String             @default("")
  icon             String?
  // fractional-indexing key; the migration sets COLLATE "C"
  position         String
  visibility       DocumentVisibility @default(WORKSPACE)
  createdBy        String             @map("created_by") @db.Uuid
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)
  // document that started the soft delete of this subtree (restore only brings back nodes of the same deletion)
  deletedRootId    String?            @map("deleted_root_id") @db.Uuid
  // bumped atomically on content flush, title/icon change, delete and restore
  revision         BigInt             @default(0)
  contentUpdatedAt DateTime?          @map("content_updated_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  parent      Document?         @relation("DocumentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Document[]        @relation("DocumentTree")
  author      User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  shares      DocumentShare[]
  links       PublicLink[]
  updates     DocumentUpdate[]
  state       DocumentState?
  versions    DocumentVersion[]
  attachments Attachment[]
  search      DocumentSearch?
  threads     CommentThread[]

  // partial in the migration: WHERE deleted_at IS NULL
  @@index([workspaceId, parentId, position], map: "documents_tree_idx")
  @@index([workspaceId, deletedAt])
  @@index([parentId])
  @@map("documents")
}

model DocumentShare {
  id         String    @id @default(uuid(7)) @db.Uuid
  documentId String    @map("document_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       ShareRole
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
  @@map("document_shares")
}

model PublicLink {
  id         String         @id @default(uuid(7)) @db.Uuid
  documentId String         @map("document_id") @db.Uuid
  mode       PublicLinkMode
  slug       String?        @unique // VIEW links
  tokenHash  String?        @unique @map("token_hash") // EDIT links (only the hash is stored)
  expiresAt  DateTime?      @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdBy  String         @map("created_by") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator  User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([documentId, mode])
  @@map("public_links")
}

// CRDT storage (spec §5): an append-only log of Yjs updates (the tail) plus one compacted state that covers
// every log row up to `last_update_id`. Compaction folds the tail into the state and deletes the folded rows.
model DocumentUpdate {
  // bigserial: the compaction cut-off ("rows up to this id are in the state") needs a total order
  id         BigInt   @id @default(autoincrement())
  documentId String   @map("document_id") @db.Uuid
  update     Bytes
  // sha256 (hex) of `update`; a retried flush cannot insert the same bytes twice
  updateHash String   @map("update_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, updateHash])
  @@index([documentId, id])
  @@map("document_updates")
}

model DocumentState {
  documentId   String   @id @map("document_id") @db.Uuid
  state        Bytes
  // highest document_updates.id folded into `state`
  lastUpdateId BigInt   @map("last_update_id")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_states")
}

model DocumentVersion {
  id         String              @id @default(uuid(7)) @db.Uuid
  documentId String              @map("document_id") @db.Uuid
  // the whole document as one Yjs update
  state      Bytes
  kind       DocumentVersionKind
  label      String?
  // the document title at the time of the snapshot
  title      String
  // null for automatic snapshots
  createdBy  String?             @map("created_by") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt(sort: Desc)])
  @@map("document_versions")
}

enum AttachmentStatus {
  PENDING
  READY

  @@map("attachment_status")
}

// An uploaded image. The object lives in S3 under `key`; rows stay when their document is soft-deleted.
model Attachment {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  documentId  String           @map("document_id") @db.Uuid
  // ws/{workspaceId}/doc/{documentId}/{id}
  key         String           @unique
  // bytes; declared at presign time (and enforced by the upload policy), re-checked on completion
  size        Int
  mime        String
  status      AttachmentStatus @default(PENDING)
  uploadedBy  String           @map("uploaded_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  document  Document  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploader  User      @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@index([documentId])
  // stale PENDING sweep
  @@index([status, createdAt])
  @@map("attachments")
}

// The full-text index of a document (spec §7), written only by the `search-sync` worker. It holds no access
// information: permissions are applied by the query. `tsv` is generated from title (weight A) and body (weight B).
model DocumentSearch {
  documentId      String                   @id @map("document_id") @db.Uuid
  workspaceId     String                   @map("workspace_id") @db.Uuid
  title           String
  body            String
  tsv             Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, cd_unaccent(title)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, cd_unaccent(body)), 'B'::\"char\"))"))
  // `documents.revision` the row was built from; an older job never overwrites a newer row
  indexedRevision BigInt                   @map("indexed_revision")
  indexedAt       DateTime                 @default(now()) @map("indexed_at") @db.Timestamptz(6)

  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tsv], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "document_search_title_trgm_idx")
  @@index([workspaceId])
  @@map("document_search")
}

// A conversation anchored to one block of a document (`block_id` is the id the editor gives the block, which is
// not a foreign key: the block lives in the CRDT state, and a thread whose block is gone is shown as orphaned).
model CommentThread {
  id         String    @id @default(uuid(7)) @db.Uuid
  documentId String    @map("document_id") @db.Uuid
  blockId    String    @map("block_id")
  createdBy  String    @map("created_by") @db.Uuid
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy String?   @map("resolved_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  comments Comment[]

  @@index([documentId])
  @@map("comment_threads")
}

// Plain text with `@[userId]` mention tokens; never rendered as HTML. Deleting a comment keeps the row (the
// thread keeps its shape) and blanks the body.
model Comment {
  id        String    @id @default(uuid(7)) @db.Uuid
  threadId  String    @map("thread_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  thread   CommentThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  mentions CommentMention[]

  @@index([threadId])
  @@index([authorId])
  @@map("comments")
}

model CommentMention {
  commentId String @map("comment_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

// In-app notification of one user. `dedupe_key` makes creation idempotent: `comment:{commentId}:{userId}` for a
// mention in a comment (and `doc:{documentId}:{userId}` for one in a document body).
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  payload   Json
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  dedupeKey String           @unique @map("dedupe_key")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_user_id_list_idx")
  @@map("notifications")
}
