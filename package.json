{
  "name": "collab-docs",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm build:libs && pnpm -r --parallel --filter './apps/*' dev",
    "build:libs": "pnpm --filter './packages/*' --if-present build",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm build:libs && pnpm -r typecheck",
    "test": "pnpm build:libs && pnpm -r test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
