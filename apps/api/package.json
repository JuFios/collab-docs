{
  "name": "@collab-docs/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js --passWithNoTests",
    "test:integration": "jest --config jest.int.config.js",
    "reindex": "node --env-file-if-exists=../../.env dist/scripts/reindex.js",
    "openapi:export": "nest build && node --env-file=../../.env.example dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@aws-sdk/s3-presigned-post": "3.1158.0",
    "@aws-sdk/s3-request-presigner": "3.1158.0",
    "@collab-docs/db": "workspace:*",
    "@collab-docs/nest": "workspace:*",
    "@collab-docs/shared": "workspace:*",
    "@nestjs/axios": "4.0.1",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/microservices": "11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prometheus-io/client": "0.16.1",
    "axios": "1.21.0",
    "bullmq": "6.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nodemailer": "10.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "1.16.20",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "ioredis": "5.11.1",
    "jest": "^30.5.2",
    "supertest": "7.3.1",
    "yjs": "13.6.33"
  }
}
