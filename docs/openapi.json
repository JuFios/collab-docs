  "info": {
    "title": "Collab Docs API",
    "description": "REST API of the Collab Docs workspace. Document content is edited over WebSocket (CRDT).",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "access-cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cd_at"
      },
      "refresh-cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cd_rt"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            }
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace",
            "maxLength": 100
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "AuthUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "AuthSessionResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserResponse"
          },
          "accessToken": {
            "type": "string",
            "description": "Access JWT, also set as the httpOnly cookie cd_at. Usable as a Bearer token."
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds."
          }
        },
        "required": [
          "user",
          "accessToken",
          "expiresIn"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateWorkspaceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme",
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ]
      },
      "WorkspaceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ],
            "description": "The caller's role"
          },
          "plan": {
            "type": "string",
            "enum": [
              "FREE",
              "PRO",
              "TEAM"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role",
          "plan",
          "createdAt"
        ]
      },
      "UpdateWorkspaceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme",
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ]
      },
      "UsageMembers": {
        "type": "object",
        "properties": {
          "current": {
            "type": "number"
          },
          "pendingInvites": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "current",
          "pendingInvites",
          "limit"
        ]
      },
      "UsageDocuments": {
        "type": "object",
        "properties": {
          "current": {
            "type": "number"
          },
          "limit": {
            "type": "number",
            "nullable": true,
            "description": "null = unlimited"
          }
        },
        "required": [
          "current"
        ]
      },
      "UsageStorage": {
        "type": "object",
        "properties": {
          "currentBytes": {
            "type": "number"
          },
          "limitBytes": {
            "type": "number"
          }
        },
        "required": [
          "currentBytes",
          "limitBytes"
        ]
      },
      "UsageResponse": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "FREE",
              "PRO",
              "TEAM"
            ]
          },
          "members": {
            "$ref": "#/components/schemas/UsageMembers"
          },
          "documents": {
            "$ref": "#/components/schemas/UsageDocuments"
          },
          "storage": {
            "$ref": "#/components/schemas/UsageStorage"
          }
        },
        "required": [
          "plan",
          "members",
          "documents",
          "storage"
        ]
      },
      "MemberResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          },
          "joinedAt": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "name",
          "email",
          "role",
          "joinedAt"
        ]
      },
      "UpdateMemberDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "CreateInviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "grace@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "InviteResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          },
          "expiresAt": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "invitedBy": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "expiresAt",
          "createdAt",
          "invitedBy"
        ]
      },
      "InvitePreviewResponse": {
        "type": "object",
        "properties": {
          "workspaceName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          },
          "inviterName": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "workspaceName",
          "email",
          "role",
          "inviterName",
          "expiresAt"
        ]
      },
      "AcceptInviteResponse": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          }
        },
        "required": [
          "workspaceId",
          "role"
        ]
      },
      "CreateDocumentDto": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "format": "uuid",
            "description": "Omit to create at the workspace root"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "example": "Meeting notes"
          }
        },
        "required": [
          "title"
        ]
      },
      "DocumentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": "object",
            "format": "uuid",
            "nullable": true,
            "description": "null when the parent is hidden from the caller"
          },
          "title": {
            "type": "string"
          },
          "icon": {
            "type": "object",
            "nullable": true
          },
          "position": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "WORKSPACE",
              "RESTRICTED"
            ]
          },
          "createdBy": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "number"
          },
          "myAccess": {
            "type": "string",
            "enum": [
              "VIEW",
              "COMMENT",
              "EDIT",
              "MANAGE"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "workspaceId",
          "parentId",
          "title",
          "icon",
          "position",
          "visibility",
          "createdBy",
          "revision",
          "myAccess",
          "createdAt",
          "updatedAt"
        ]
      },
      "TreeNodeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          },
          "title": {
            "type": "string"
          },
          "icon": {
            "type": "object",
            "nullable": true
          },
          "position": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "WORKSPACE",
              "RESTRICTED"
            ]
          },
          "myAccess": {
            "type": "string",
            "enum": [
              "VIEW",
              "COMMENT",
              "EDIT",
              "MANAGE"
            ]
          }
        },
        "required": [
          "id",
          "parentId",
          "title",
          "icon",
          "position",
          "visibility",
          "myAccess"
        ]
      },
      "TrashItemResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "icon": {
            "type": "object",
            "nullable": true
          },
          "deletedAt": {
            "type": "string"
          },
          "documentCount": {
            "type": "number",
            "description": "Live documents restored together with it"
          },
          "canRestore": {
            "type": "boolean",
            "description": "Whether the caller may restore it"
          }
        },
        "required": [
          "id",
          "title",
          "icon",
          "deletedAt",
          "documentCount",
          "canRestore"
        ]
      },
      "UpdateDocumentDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "icon": {
            "type": "object",
            "nullable": true,
            "maxLength": 32,
            "description": "Emoji; null clears it"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "WORKSPACE",
              "RESTRICTED"
            ]
          }
        }
      },
      "MoveDocumentDto": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "object",
            "format": "uuid",
            "nullable": true,
            "description": "New parent; null moves to the root"
          },
          "beforeId": {
            "type": "string",
            "format": "uuid",
            "description": "Place the document right before this sibling"
          },
          "afterId": {
            "type": "string",
            "format": "uuid",
            "description": "Place the document right after this sibling"
          }
        },
        "required": [
          "parentId"
        ]
      },
      "MovedDocumentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": "object",
            "format": "uuid",
            "nullable": true
          },
          "position": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "parentId",
          "position"
        ]
      },
      "SharedDocumentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "icon": {
            "type": "object",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "VIEWER",
              "EDITOR"
            ]
          }
        },
        "required": [
          "id",
          "workspaceId",
          "title",
          "icon",
          "role"
        ]
      },
      "ShareResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "VIEWER",
              "EDITOR"
            ]
          }
        },
        "required": [
          "userId",
          "email",
          "name",
          "role"
        ]
      },
      "CreateShareDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "grace@example.com",
            "description": "Must belong to a registered user"
          },
          "role": {
            "type": "string",
            "enum": [
              "VIEWER",
              "EDITOR"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "UpdateShareDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "VIEWER",
              "EDITOR"
            ]
          }
        },
        "required": [
          "role"
        ]
      }
    }
  }
}
