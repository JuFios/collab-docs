# Optional: `docker compose up` works without this file because docker-compose.yml carries dev-only
# defaults. Copy to `.env` to override any value (also used when running services outside Docker).

APP_ENV=dev                 # dev | staging | test
NODE_ENV=development
LOG_LEVEL=debug             # fatal|error|warn|info|debug|trace|silent

# --- Host ports published by compose ---
WEB_PORT=3000
API_PORT=4000
COLLAB_PORT=4001            # public WebSocket port; internal API port 4002 is never published
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SMTP_HOST_PORT=1025
MAILPIT_UI_PORT=8025

# --- Postgres / Redis ---
POSTGRES_PASSWORD=dev-only-postgres-password
DATABASE_URL=postgresql://collab:dev-only-postgres-password@postgres:5432/collab
REDIS_URL=redis://redis:6379

# --- S3 storage (MinIO) ---
S3_ENDPOINT=http://minio:9000                 # used by api/worker inside the network
S3_PUBLIC_ENDPOINT=http://localhost:9000      # host that browsers use for presigned URLs (part of the signature)
S3_BUCKET=collab-docs
S3_ACCESS_KEY=dev-only-minio
S3_SECRET_KEY=dev-only-minio-secret

# --- Mail (Mailpit UI: http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Collab Docs <noreply@collab-docs.local>

# --- Secrets (>= 16 chars). Replace for anything but local development. ---
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-me
COLLAB_TICKET_SECRET=dev-only-collab-ticket-secret-change-me
INTERNAL_API_TOKEN=dev-only-internal-api-token-change-me
REVALIDATE_SECRET=dev-only-revalidate-secret-change-me
WEBHOOK_SIGNING_SECRET=dev-only-webhook-signing-secret-change-me

# --- URLs ---
WEB_ORIGIN=http://localhost:3000              # browser origin; also the CORS origin for MinIO uploads
WEB_INTERNAL_URL=http://web:3000
API_INTERNAL_URL=http://api:4000
COLLAB_INTERNAL_URL=tcp://collab:4002         # internal collab API (TCP), reachable only inside the network
COLLAB_PUBLIC_URL=ws://localhost:4001
TRUSTED_PROXY_CIDRS=172.16.0.0/12             # proxies whose x-forwarded-for is trusted

BILLING_PROVIDER=mock

# --- Tunables (defaults shown; all optional) ---
# CORS_ALLOWED_ORIGINS=                      # comma-separated extra origins (WEB_ORIGIN is always allowed)
# HTTP_BODY_LIMIT=1mb
# RATE_GLOBAL_PER_MIN_IP=600
# RATE_TICKET_PER_MIN_USER=30
# COLLAB_FLUSH_INTERVAL_MS=1000
# DASHBOARD_BLOCK_DELAY_MS=0                 # web only: artificial dashboard latency for the streaming e2e test (ignored in staging)
# COLLAB_FLUSH_MAX_WAIT_MS=5000
# COLLAB_COMPACT_MAX_ROWS=100
# COLLAB_COMPACT_MAX_BYTES=524288
# AUTO_VERSION_INTERVAL_MS=600000
# ATTACHMENT_MAX_BYTES=10485760              # largest single image (hard limit enforced by the upload policy)
# ATTACHMENT_PENDING_TTL_HOURS=24            # uploads never completed are swept after this long
# REVALIDATE_DEBOUNCE_MS=3000
# SEARCH_DEBOUNCE_MS=5000
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
# RATE_LOGIN_PER_MIN_IP_EMAIL=5
# RATE_LOGIN_PER_MIN_IP=20
# RATE_REGISTER_PER_HOUR_IP=10
# RATE_PUBLIC_LINK_PER_HOUR_USER=10
# RATE_GUEST_TICKET_PER_MIN_IP=30
# COLLAB_MAX_MESSAGES_PER_10S=200
# COLLAB_MAX_UPDATE_BYTES=1048576
# COLLAB_MAX_DOCUMENT_BYTES=10485760
# COLLAB_MAX_CONNECTIONS_PER_DOCUMENT=100
# COLLAB_MAX_AWARENESS_BYTES=4096
# COLLAB_ROOM_IDLE_MS=30000
# COLLAB_ACCESS_RECHECK_MS=60000
