  "info": {
    "title": "Collab Docs API",
    "description": "REST API of the Collab Docs workspace. Document content is edited over WebSocket (CRDT).",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "access-cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cd_at"
      },
      "refresh-cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cd_rt"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            }
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace",
            "maxLength": 100
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "AuthUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "AuthSessionResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserResponse"
          },
          "accessToken": {
            "type": "string",
            "description": "Access JWT, also set as the httpOnly cookie cd_at. Usable as a Bearer token."
          },
          "expiresIn": {
            "type": "number",
            "description": "Access token lifetime in seconds."
          }
        },
        "required": [
          "user",
          "accessToken",
          "expiresIn"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateWorkspaceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme",
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ]
      },
      "WorkspaceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ],
            "description": "The caller's role"
          },
          "plan": {
            "type": "string",
            "enum": [
              "FREE",
              "PRO",
              "TEAM"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role",
          "plan",
          "createdAt"
        ]
      },
      "UpdateWorkspaceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme",
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ]
      },
      "UsageMembers": {
        "type": "object",
        "properties": {
          "current": {
            "type": "number"
          },
          "pendingInvites": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          }
        },
        "required": [
          "current",
          "pendingInvites",
          "limit"
        ]
      },
      "UsageDocuments": {
        "type": "object",
        "properties": {
          "current": {
            "type": "number"
          },
          "limit": {
            "type": "number",
            "nullable": true,
            "description": "null = unlimited"
          }
        },
        "required": [
          "current"
        ]
      },
      "UsageStorage": {
        "type": "object",
        "properties": {
          "currentBytes": {
            "type": "number"
          },
          "limitBytes": {
            "type": "number"
          }
        },
        "required": [
          "currentBytes",
          "limitBytes"
        ]
      },
      "UsageResponse": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "FREE",
              "PRO",
              "TEAM"
            ]
          },
          "members": {
            "$ref": "#/components/schemas/UsageMembers"
          },
          "documents": {
            "$ref": "#/components/schemas/UsageDocuments"
          },
          "storage": {
            "$ref": "#/components/schemas/UsageStorage"
          }
        },
        "required": [
          "plan",
          "members",
          "documents",
          "storage"
        ]
      },
      "MemberResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          },
          "joinedAt": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "name",
          "email",
          "role",
          "joinedAt"
        ]
      },
      "UpdateMemberDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "CreateInviteDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "grace@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "InviteResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "EDITOR",
              "VIEWER"
            ]
          },
          "expiresAt": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "invitedBy": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "expiresAt",
          "createdAt",
          "invitedBy"
        ]
      },
      "InvitePreviewResponse": {
        "type": "object",
        "properties": {
          "workspaceName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
