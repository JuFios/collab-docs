# Staging profile. Copy to `.env.staging`, fill in EVERY value, then run:
#   docker compose --env-file .env.staging -f docker-compose.yml -f docker-compose.staging.yml up -d
# Compose refuses to start while a required value is empty, and the services reject values that
# still look like development placeholders. Generate secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=
DATABASE_URL=postgresql://collab:<POSTGRES_PASSWORD>@postgres:5432/collab
REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://files.example.com
S3_BUCKET=collab-docs
S3_ACCESS_KEY=
S3_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

JWT_ACCESS_SECRET=
COLLAB_TICKET_SECRET=
INTERNAL_API_TOKEN=
REVALIDATE_SECRET=
WEBHOOK_SIGNING_SECRET=

WEB_ORIGIN=https://app.example.com
COLLAB_PUBLIC_URL=wss://collab.example.com
TRUSTED_PROXY_CIDRS=172.16.0.0/12
LOG_LEVEL=info
